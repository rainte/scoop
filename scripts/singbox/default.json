{
  "dns": {
    "servers": [{ "type": "tls", "tag": "dns-proxy", "server": "1.1.1.1", "detour": "proxy" }]
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080,
      "set_system_proxy": false
    }
  ],
  "outbounds": [
    {
      "type": "hysteria",
      "tag": "proxy",
      "server": "137.175.82.43",
      "server_port": 443,
      "up_mbps": 20,
      "down_mbps": 20,
      "auth_str": "dongtaiwang.com",
      "tls": { "enabled": true, "insecure": true, "server_name": "bing.com", "alpn": ["h3"] }
    },
    { "type": "direct", "tag": "direct" }
  ],
  "http_clients": [{ "tag": "downloader", "detour": "proxy" }],
  "route": {
    "final": "proxy",
    "auto_detect_interface": true,
    "default_http_client": "downloader",
    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "ip_is_private": true, "outbound": "direct" },
      { "rule_set": ["geoip-us"], "outbound": "proxy" },
      { "rule_set": ["geoip-cn"], "outbound": "direct" }
    ],
    "rule_set": [
      {
        "tag": "geoip-us",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-us.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ]
  }
}
